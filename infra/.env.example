# PerformTest — Yerli Sunucu (On-Premise) Ortam Değişkenleri Şablonu
# Üretim ortamında bu dosyayı `.env` olarak kopyalayıp gizli anahtarları güncelleyin.

PERFORMTEST_ORTAM=production
PERFORMTEST_JWT_SECRET=degistirin-en-az-32-karakterli-kriptografik-anahtar-2026

POSTGRES_USER=performtest_kullanici
POSTGRES_PASSWORD=performtest_guclu_parola_2026
POSTGRES_DB=performtest_db

PERFORMTEST_DATABASE_URL=postgresql+psycopg://performtest_kullanici:performtest_guclu_parola_2026@postgres:5432/performtest_db
PERFORMTEST_VERI_DIZINI=/app/yerel_veri
PERFORMTEST_YEDEK_DIZINI=/app/yerel_veri/yedekler

